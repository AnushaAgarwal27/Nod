# Copy to .env and fill in. Never commit .env.

# --- Cognee (owner: B) ---
NOD_USE_COGNEE=0            # 1 = real Cognee, 0 = local JSON fallback in memory/
LLM_API_KEY=                # used by Cognee for cognify/search
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# --- Flexprice (owner: C) ---
NOD_USE_FLEXPRICE=0         # 1 = real Flexprice API, 0 = local ledger in memory/
FLEXPRICE_API_KEY=
FLEXPRICE_API_URL=https://api.cloud.flexprice.io/v1
FLEXPRICE_CUSTOMER_ID=invoiceflow-demo
NOD_FREE_CREDITS=20

# --- Snyk (owner: C) ---
# Run `snyk auth` once; SNYK_TOKEN is optional for CI
SNYK_TOKEN=

# --- InvoiceFlow demo app ---
REMINDER_API_KEY=
